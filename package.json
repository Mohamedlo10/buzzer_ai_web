{
  "name": "xalaat-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "scripts": {
    "postinstall": "patch-package",
    "test": "npm run test:tokens && npm run test:routes && npm run test:confirm && npm run test:session-routing && npm run test:packet-perf && npm run test:ui-perf",
    "test:tokens": "node packages/core/src/lib/theme/palette.test.js",
    "test:routes": "node --experimental-strip-types --no-warnings packages/core/src/lib/auth/routePolicy.test.mjs",
    "test:confirm": "node --experimental-strip-types --no-warnings packages/core/src/lib/ui/confirm.test.mjs",
    "test:session-routing": "node --experimental-strip-types --no-warnings packages/core/src/lib/game/sessionRouting.test.mjs",
    "test:packet-perf": "npx tsx packages/core/src/lib/game/packetPerformance.test.mjs",
    "test:ui-perf": "node packages/core/src/lib/game/uiResponsiveness.test.mjs",
    "test:stress-live": "node stress-test-live.mjs",
    "game": "npm --workspace apps/game run start",
    "game:web": "npm --workspace apps/game run web",
    "game:ios": "npm --workspace apps/game run ios",
    "game:android": "npm --workspace apps/game run android",
    "dev": "npm --workspace apps/web-legacy run dev",
    "build": "npm --workspace apps/web-legacy run build",
    "lint": "npm --workspace apps/web-legacy run lint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "version": "1.0.0"
}
