{
  "expo": {
    "name": "Xalaat",
    "slug": "buzzmaster-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "buzzmaster",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1E5C9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buzzmaster.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1E5C9"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.buzzmaster.ai"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
