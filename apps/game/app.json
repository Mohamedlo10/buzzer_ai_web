{
  "expo": {
    "name": "Xalaat",
    "slug": "buzzmaster-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "buzzmaster",
      "com.googleusercontent.apps.900221029605-0rjg1510ruauf4r3pf8nufb3mif1ssbk"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buzzmaster.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1E5C9"
      },
      "package": "com.buzzmaster.ai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Xalaat à utiliser l'appareil photo pour scanner les QR codes des salons et parties."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "849f7c7c-04de-4b11-889f-0de50038707f"
      }
    }
  }
}
