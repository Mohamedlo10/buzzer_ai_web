{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "~/avatar": [
        "../../packages/avatar/src/index.ts"
      ],
      "~/avatar/*": [
        "../../packages/avatar/src/*"
      ],
      "~/lib/*": [
        "../../packages/core/src/lib/*"
      ],
      "~/stores/*": [
        "../../packages/core/src/stores/*"
      ],
      "~/types/*": [
        "../../packages/core/src/types/*"
      ],
      "~/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
