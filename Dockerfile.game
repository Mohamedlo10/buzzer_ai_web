# Stage 1: Build Expo Web
FROM node:20-alpine AS builder
WORKDIR /app

# Copy monorepo manifests
COPY package.json package-lock.json ./
COPY patches ./patches
COPY packages ./packages
COPY apps/game ./apps/game
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/web-legacy/package.json ./apps/web-legacy/package.json

RUN npm install --legacy-peer-deps

ARG EXPO_PUBLIC_API_URL=https://apiquiz.mouhadev.com
ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=900221029605-bik3pth58uq0ipa69n20vdodpaa1dbq7.apps.googleusercontent.com
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
ENV NODE_ENV=production

WORKDIR /app/apps/game
RUN npx expo export -p web

# Stage 2: Serve with Nginx
FROM nginx:alpine
COPY --from=builder /app/apps/game/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
